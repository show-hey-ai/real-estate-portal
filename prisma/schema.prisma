generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      Role       @default(USER)
  locale    String     @default("ja")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  adminLogs AdminLog[]
  favorites Favorite[]
  leads     Lead[]
  listings  Listing[]  @relation("CreatedBy")

  @@map("users")
}

model Listing {
  buyerRecommendations BuyerRecommendation[]
  chatSeller PropertyChatSeller?
  chatRooms PropertyChatRoom[]
  id                   String               @id @default(cuid())
  status               ListingStatus        @default(DRAFT)
  propertyType         String?
  price                BigInt?
  priceCurrency        String               @default("JPY")
  prefecture           String?
  city                 String?
  addressPublic        String?
  addressPrivate       String?
  addressBlocked       Boolean              @default(false)
  addressFull          String?
  latitude             Decimal?             @db.Decimal(10, 8)
  longitude            Decimal?             @db.Decimal(11, 8)
  stations             Json?
  builtYear            Int?
  builtMonth           Int?
  currentStatus        String?
  buildingArea         Decimal?             @db.Decimal(10, 2)
  landArea             Decimal?             @db.Decimal(10, 2)
  floorCount           Int?
  unitCount            Int?
  structure            String?
  landRights           String?
  zoning               String?
  buildingCoverageRatio Decimal?            @db.Decimal(5, 2)
  floorAreaRatio       Decimal?             @db.Decimal(5, 2)
  yieldGross           Decimal?             @db.Decimal(5, 2)
  yieldNet             Decimal?             @db.Decimal(5, 2)
  annualIncome         BigInt?
  annualExpenses       BigInt?
  occupancyRate        Decimal?             @db.Decimal(5, 2)
  vacantUnits          Int?
  currentRentRoll      Json?
  features             Json?
  featuresEn           Json?
  featuresZhTw         Json?
  featuresZhCn         Json?
  warnings             Json?
  descriptionJa        String?              @db.Text
  descriptionEn        String?              @db.Text
  descriptionZhTw      String?              @db.Text
  descriptionZhCn      String?              @db.Text
  sourceUrl            String?
  fetchedAt            DateTime?
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  publishedAt          DateTime?
  viewCount            Int                  @default(0)
  infoRegisteredAt     DateTime?
  infoUpdatedAt        DateTime?
  conditionsExpiry     DateTime?
  deliveryDate         String?
  adAllowed            Boolean              @default(false)
  adConsentRequired    Boolean              @default(false)
  extractionConfidence Decimal?             @db.Decimal(3, 2)
  sourcePdfUrl         String?
  sourcePropertyId     String?              @unique
  autonomyValidUntil   DateTime?
  sourcePdfPages       Int?
  adminNotes           String?              @db.Text
  managementId         String?              @unique
  hospitalityCategory  String?              // EXISTING_HOTEL | LICENSED_PROPERTY | RENOVATION_TARGET | NEW_BUILD_LAND | CONVERSION_CANDIDATE
  createdBy            User?                @relation("CreatedBy", fields: [createdById], references: [id])
  evidences            ExtractionEvidence[]
  favorites            Favorite[]
  leads                Lead[]
  media                Media[]
  siteVisitEvents      SiteVisitEvent[]

  @@map("listings")
}

model PropertyChatSeller {
  listingId String @id
  sellerSubject String @db.Uuid
  assignedBy String @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@map("property_chat_sellers")
}

model PropertyChatRoom {
  sellerKind String @default("seller")
  stage String @default("consultation")
  id String @id @db.Uuid
  listingId String
  buyerSubject String @db.Uuid
  sellerSubject String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages PropertyChatMessage[]
  @@unique([listingId, buyerSubject, sellerSubject])
  @@index([buyerSubject, updatedAt(sort: Desc)], map: "property_chat_buyer")
  @@index([sellerSubject, updatedAt(sort: Desc)], map: "property_chat_seller")
  @@map("property_chat_rooms")
}

model PropertyChatMessage {
  kind String @default("text")
  details Json @default("{}")
  id String @id @db.Uuid
  roomId String @db.Uuid
  senderSubject String @db.Uuid
  clientNonce String @db.Uuid
  body String
  language String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  room PropertyChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([roomId, senderSubject, clientNonce])
  @@index([roomId, createdAt, id], map: "property_chat_messages_room")
  @@map("property_chat_messages")
}

model PropertyChatOperator {
  id String @id
  subject String @db.Uuid
  configuredAt DateTime @default(now()) @db.Timestamptz(6)
  @@map("property_chat_operator")
}

model TransitLineMaster {
  id             String               @id
  canonicalName  String               @unique
  displayNameJa  String
  operatorNameJa String?
  sourceLineName String?
  sourceDataset  String?
  sortOrder      Int                  @default(0)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  stations       TransitStationMaster[]

  @@map("transit_line_master")
}

model TransitStationMaster {
  id                String            @id
  lineId            String
  canonicalName     String
  displayNameJa     String
  ward              String
  sourceStationName String?
  sourceStationCode String?
  sourceGroupCode   String?
  sortOrder         Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  line              TransitLineMaster @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, canonicalName])
  @@index([lineId, sortOrder])
  @@index([ward])
  @@map("transit_station_master")
}

model SiteVisitEvent {
  id           String   @id @default(cuid())
  visitorId    String
  pathname     String
  queryString  String?
  pageType     String
  locale       String?
  referrerUrl  String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  listingId    String?
  occurredAt   DateTime @default(now())
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([pageType, occurredAt])
  @@index([pathname, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([listingId, occurredAt])
  @@index([referrerHost, occurredAt])
  @@map("site_visit_events")
}

model Media {
  id        String        @id @default(cuid())
  listingId String
  category  MediaCategory @default(OTHER)
  source    MediaSource   @default(EXTRACTED)
  url       String
  caption   String?
  sortOrder Int           @default(0)
  isAdopted Boolean       @default(true)
  createdAt DateTime      @default(now())
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("media")
}

model ExtractionEvidence {
  id          String   @id @default(cuid())
  listingId   String
  fieldName   String
  rawText     String?
  pageNumber  Int?
  confidence  Decimal? @db.Decimal(3, 2)
  needsReview Boolean  @default(false)
  createdAt   DateTime @default(now())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("extraction_evidences")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}

model Lead {
  id            String        @id @default(cuid())
  userId        String
  listingId     String
  contactMethod ContactMethod
  contactValue  String?
  message       String?
  status        LeadStatus    @default(NEW)
  adminNotes    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  IN_REVIEW
  REVIEWED
  PUBLISHED
  SOLD
  ARCHIVED
}

enum MediaCategory {
  EXTERIOR
  INTERIOR
  FLOORPLAN
  MAP
  DOCUMENT
  TABLE
  OTHER
}

enum MediaSource {
  EXTRACTED
  MANUAL
}

enum ContactMethod {
  EMAIL
  PHONE
  LINE
  WHATSAPP
  WECHAT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  CONVERTED
  CLOSED
}

// Private operating state. Public clients have no access to these tables.
model AutonomyPolicy {
  id                 String   @id
  enabled            Boolean  @default(false)
  objective          String   @db.Text
  intervalMinutes    Int      @default(60)
  monthlyBudgetYen   Int      @default(0)
  aiCallReserveYen   Int      @default(100)
  allowAiStrategy    Boolean  @default(false)
  allowPublication   Boolean  @default(false)
  allowArchive       Boolean  @default(false)
  allowReinsIntake   Boolean  @default(false)
  allowArticles      Boolean  @default(false)
  allowSeo           Boolean  @default(false)
  reinsIntervalHours Int      @default(24)
  reinsBatchReserveYen Int    @default(1000)
  maxAttempts        Int      @default(3)
  lastHeartbeatAt    DateTime?
  lastSourceHeartbeatAt DateTime?
  updatedAt          DateTime @updatedAt
  jobs               AutonomyJob[]
  records            AutonomyRecord[]

  @@map("autonomy_policies")
}

model PortalArticle {
  slug         String   @id
  city         String
  status       String   @default("DRAFT")
  locales      Json
  sourceHash   String
  sourceIds    Json
  version      String
  publishedAt  DateTime?
  updatedAt    DateTime @updatedAt

  @@map("portal_articles")
}

model AutonomyJob {
  id             String   @id @default(cuid())
  ventureId      String
  kind           String
  status         String   @default("pending")
  dedupeKey      String
  payload        Json
  result         Json?
  priority       Int      @default(0)
  attempts       Int      @default(0)
  availableAt    DateTime @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  policy         AutonomyPolicy @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  runs           AutonomyRun[]

  @@unique([ventureId, dedupeKey])
  @@index([ventureId, status, availableAt])
  @@map("autonomy_jobs")
}

model AutonomyRun {
  id               String   @id @default(cuid())
  jobId            String
  leaseToken       String   @unique
  outcome          String   @default("running")
  reservedCostYen  Int      @default(0)
  actualCostYen    Int?
  providerReceipt  String?
  pendingProviderRequests Int @default(0)
  inputTokens      Int?
  outputTokens     Int?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  job              AutonomyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@map("autonomy_runs")
}

model AutonomyRecord {
  id           String   @id @default(cuid())
  ventureId    String
  dedupeKey    String
  recordType   String
  title        String
  content      Json
  sources      Json
  verification String   @default("unverified")
  version      String
  createdAt    DateTime @default(now())
  policy       AutonomyPolicy @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@unique([ventureId, dedupeKey])
  @@index([ventureId, recordType, createdAt])
  @@map("autonomy_records")
}

model BuyerSearchProfile {
  id String @id @db.Uuid
  buyerSubject String @unique @db.Uuid
  revision Int @default(1)
  active Boolean @default(true)
  criteria Json
  matchGeneration String? @db.Uuid
  lastMatchedAt DateTime? @db.Timestamptz(6)
  lastSourceAttemptAt DateTime? @db.Timestamptz(6)
  lastSourceAt DateTime? @db.Timestamptz(6)
  sourceCursor Int @default(0)
  sourceState String @default("waiting")
  sourcePlan Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  recommendations BuyerRecommendation[]
  @@index([active,lastMatchedAt,lastSourceAttemptAt],map:"buyer_search_due")
  @@map("buyer_search_profiles")
}
model BuyerRecommendation {
  profileId String @db.Uuid
  listingId String
  profileRevision Int
  matchGeneration String @db.Uuid
  listingUpdatedAt DateTime @db.Timestamp(3)
  listingHash String
  evaluation Json
  score Int
  status String
  suggestedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  profile BuyerSearchProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  listing Listing @relation(fields:[listingId],references:[id],onDelete:Cascade)
  feedback BuyerFeedback?
  @@id([profileId,listingId])
  @@map("buyer_recommendations")
}
model BuyerFeedback {
  profileId String @db.Uuid
  listingId String
  rating Int?
  status String
  reason String
  lastNonce String @db.Uuid
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  recommendation BuyerRecommendation @relation(fields:[profileId,listingId],references:[profileId,listingId],onDelete:Cascade)
  @@id([profileId,listingId])
  @@map("buyer_feedback")
}
