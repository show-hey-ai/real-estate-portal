# Database (Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Optional: literal multiline PEM from Supabase Database Settings > Download certificate.
# Configuring this requires TLS with certificate and hostname verification.
DATABASE_SSL_CA=""

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# OpenAI (マイソクAI処理: 広告判定・帯切り取り・OCR・詳細抽出・翻訳)
OPENAI_API_KEY="sk-..."
MAISOKU_AD_MODEL="gpt-4.1"
MAISOKU_BANNER_MODEL="gpt-4.1"
MAISOKU_OCR_MODEL="gpt-4.1-mini"
MAISOKU_EXTRACT_MODEL="gpt-4.1-mini"
MAISOKU_TRANSLATE_MODEL="gpt-4.1-mini"

# Jev (マイソク抽出後の社内向け予備判定。サーバー側のみ)
JEV_API_KEY=""
JEV_MODEL="jev-latest"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Portal autonomy (set initial objective, permissions and budget at /admin/autonomy)
# Same random 32+ character secret on the deployment and the GitHub clock.
AUTONOMY_CRON_SECRET=""
AUTONOMY_STRATEGY_MODEL="gpt-4.1-mini"
# Source worker only: persistent private directory; never store it under public/.
AUTONOMY_SOURCE_DIR=""
REINS_LOGIN_ID=""
REINS_LOGIN_PW=""
REINS_AREA="東京都"
# Use false on a logged-in desktop if the source site requires a standard browser.
REINS_HEADLESS="true"
# Existing REINS search settings apply; configure area/property types before starting.
IMPORT_ADMIN_USER_ID=""

# Source worker only: email alerts (inquiries, buyer chat, expiring listings, failed jobs) and an 08:00 JST digest.
# Sending is disabled unless NOTIFY_EMAIL_TO, SMTP_USER and SMTP_PASS are all set. For Gmail use an app password.
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
